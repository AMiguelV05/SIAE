# Clave de Groq para generar respuestas y leer imágenes o páginas escaneadas con visión.
GROQ_API_KEY=

# Configuración local: base SQLite, carpeta de archivos y límites de tamaño.
DATABASE_URL=sqlite:///./siae_local.db
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
MAX_URL_DOWNLOAD_MB=50

# Actualización automática de fuentes públicas: activación, intervalo y demora inicial.
SIAE_AUTO_REFRESH_SOURCES=true
SIAE_SOURCE_REFRESH_HOURS=96
SIAE_SOURCE_REFRESH_START_DELAY_SECONDS=30

# El mismo modelo de embeddings se usa al indexar documentos y buscar información.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Dispositivo para ejecutar el modelo; vacío permite elegir automáticamente. Ejemplos: cpu, cuda.
EMBEDDING_DEVICE=
# Cantidad de fragmentos procesados juntos al generar embeddings.
EMBEDDING_BATCH_SIZE=32
# Tamaño de cada fragmento y cantidad de palabras repetidas entre fragmentos consecutivos.
CHUNK_SIZE_WORDS=100
CHUNK_OVERLAP_WORDS=20

# Valor predeterminado de top_k en el RAG; /messages/ask fija actualmente el valor en 6.
RAG_TOP_K=6
# Puntuación mínima para conservar coincidencias semánticas; también se aceptan coincidencias léxicas fuertes.
RAG_MIN_SCORE=0.25
# Modelos de lenguaje para respuestas y lectura visual, con sus límites de salida.
LLM_MODEL=openai/gpt-oss-120b
VISION_MODEL=qwen/qwen3.8-27b
VISION_MAX_TOKENS=850
# Activa lectura visual de páginas PDF con imágenes incrustadas de al menos este tamaño en píxeles.
PDF_OCR_MIN_IMAGE_PIXELS=250000
LLM_MAX_TOKENS=900

# Direcciones web autorizadas para llamar a la API desde el navegador, separadas por comas.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
